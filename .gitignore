# ── Python 虚拟环境 ────────────────────────────────────────────
.venv/
venv/
env/

# ── Python 缓存 ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 运行时数据（索引 / 收藏表 / 屏蔽表 / 日志 / 单实例锁）─────
# 这些是每台机器自己的状态，不应进版本库
data/

# ── 已下载的壁纸缓存 + 合成成品 ──────────────────────────────
cache/

# ── 用户收藏夹 ────────────────────────────────────────────────
Favorites/

# ── 构建产物（.app staging / 打包中间文件）────────────────────
# 只忽略仓库根的 build/；scripts/build/ 是构建链源码，必须进版本库
/build/

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?

# ── 编辑器 ────────────────────────────────────────────────────
.idea/
.vscode/
*.swp

# 本地私密配置覆盖（API Key 等，不入库）
/config.local.yaml
